<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template
        id="vending_machine_page"
        name="Vending Machine"
    >

        <t t-call="website.layout">

            <div class="container py-5">

                <!-- MACHINE HEADER -->

                <div class="text-center mb-5">

                    <h1>
                        <t t-esc="machine.name"/>
                    </h1>

                    <p class="text-muted">
                        Sélectionnez un produit
                    </p>

                </div>


                <!-- PRODUCTS -->

                <div class="row justify-content-center">

                    <t t-foreach="slots" t-as="slot">

                        <div class="col-12 col-md-6 col-lg-4 mb-4">

                            <div class="card h-100 shadow-sm">

                                <!-- PRODUCT IMAGE -->

                                <t t-if="slot.product_id">

                                    <img
                                        t-att-src="'/web/image/product.product/%s/image_512' % slot.product_id.id"
                                        class="card-img-top p-3"
                                        style="height: 220px; object-fit: contain;"
                                    />

                                </t>


                                <div class="card-body text-center">

                                    <!-- PRODUCT NAME -->

                                    <h4 class="card-title">

                                        <t t-esc="slot.product_id.display_name"/>

                                    </h4>


                                    <!-- PRICE -->

                                    <div class="fs-3 fw-bold my-3">

                                        <t t-esc="'%.2f $' % slot.price"/>

                                    </div>


                                    <!-- STOCK -->

                                    <t t-if="slot.quantity > 0">

                                        <div class="text-success mb-3">

                                            Disponible

                                        </div>

                                        <div class="text-muted small">

                                            <t t-esc="slot.quantity"/>
                                            restant(s)

                                        </div>

                                    </t>


                                    <t t-else="">

                                        <div class="text-danger fw-bold">

                                            Épuisé

                                        </div>

                                    </t>

                                </div>

                            </div>

                        </div>

                    </t>

                </div>


                <!-- EMPTY MACHINE -->

                <t t-if="not slots">

                    <div class="alert alert-info text-center">

                        Aucun produit disponible actuellement.

                    </div>

                </t>


                <!-- MACHINE CODE -->

                <div class="text-center text-muted mt-5 small">

                    Machine
                    <t t-esc="machine.code"/>

                </div>

            </div>

        </t>

    </template>

</odoo>